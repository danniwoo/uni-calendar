{
  "name": "semester-staging-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev --config wrangler.local.jsonc --local",
    "build": "wrangler deploy --config wrangler.local.jsonc --dry-run --outdir dist",
    "invite:create": "node scripts/invitations.mjs create",
    "campaign:create": "node scripts/invitations.mjs campaign-create",
    "invite:revoke": "node scripts/invitations.mjs revoke"
  },
  "dependencies": {
    "jose": "6.2.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "@types/node": "22.19.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.156.1"
  }
}
