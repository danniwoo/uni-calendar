# Setup checklist only; not wired into the existing Sites runtime.
# Copy to an ignored .env.migration.local when the actual resources exist.
# The project URL and publishable key are public configuration, not admin keys.
SUPABASE_URL=https://REPLACE_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
SUPABASE_JWT_ISSUER=https://REPLACE_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://REPLACE_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Add exact staging origins/callbacks after they are confirmed.
SEMESTER_WEB_ORIGIN=
SEMESTER_API_ORIGIN=
SEMESTER_IOS_AUTH_REDIRECT=

# Resend API key goes in Supabase SMTP settings, not this file.
# No Supabase service-role/secret key or database password belongs in clients.
