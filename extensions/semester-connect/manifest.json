{
  "manifest_version": 3,
  "name": "Semester Connect — Local Preview",
  "version": "0.4.4",
  "version_name": "0.4.4 · check from Canvas dashboard",
  "description": "Read-only USYD Canvas preview, JSON export and optional course-reload checks. Review in Semester before saving.",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://canvas.sydney.edu.au/*", "https://usyd-semester-board.earthy-trout-5263.chatgpt.site/*"],
  "action": { "default_title": "Open Semester Connect from USYD Canvas" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'; frame-src 'none'"
  }
}
