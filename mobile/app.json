{
  "expo": {
    "name": "Semester Preview",
    "slug": "semester-preview",
    "version": "0.3.9",
    "scheme": "semester-preview",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.semester.preview",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "13"
    },
    "plugins": [
      "expo-dev-client",
      "./plugins/withLocalWidgets",
      [
        "expo-widgets",
        {
          "enablePushNotifications": false,
          "widgets": [
            {
              "name": "SemesterDeadlineFocus",
              "displayName": "Deadline focus",
              "description": "Your next unfinished deadline from your imported semester. Tap to open that item.",
              "supportedFamilies": [
                "accessoryRectangular"
              ]
            },
            {
              "name": "SemesterNextClass",
              "displayName": "Next class \u00b7 Sample",
              "description": "Try Semester with a sample schedule. Tap to see class details.",
              "supportedFamilies": [
                "systemMedium"
              ]
            },
            {
              "name": "SemesterDeadline",
              "displayName": "Next deadline \u00b7 Sample",
              "description": "One deadline at a glance. Tap to open the assessment.",
              "supportedFamilies": [
                "accessoryRectangular"
              ]
            },
            {
              "name": "SemesterDeadlines",
              "displayName": "Two deadlines \u00b7 Sample",
              "description": "See the next two dated assessments. Tap to view all work.",
              "supportedFamilies": [
                "accessoryRectangular"
              ]
            },
            {
              "name": "SemesterOverview",
              "displayName": "Work overview \u00b7 Sample",
              "description": "Upcoming work and dates to check, together.",
              "supportedFamilies": [
                "systemMedium"
              ]
            },
            {
              "name": "SemesterCloudDeadline",
              "displayName": "Cloud deadline \u00b7 Trial",
              "description": "Your shared test deadlines and last sync time. Tap to open cloud work.",
              "supportedFamilies": [
                "accessoryRectangular",
                "systemMedium"
              ]
            }
          ]
        }
      ],
      "expo-web-browser",
      "expo-secure-store"
    ]
  }
}
